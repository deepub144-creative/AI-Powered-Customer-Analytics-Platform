FROM python:3.11-slim

WORKDIR /app

# Install API dependencies
COPY api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy API code and the sibling data/models folders it depends on,
# preserving the same relative layout main.py expects (../models, ../data)
COPY api/ ./api/
COPY models/ ./models/
COPY data/ ./data/

WORKDIR /app/api

# Render assigns the port via $PORT at runtime
EXPOSE 10000

CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-10000}"]